    {
      "kind": "text",
      "x": 56,
      "y": 1233,
      "text": "Apple M4 \u00b7 32 GiB RAM \u00b7 macOS 27 \u00b7 10 rounds per runtime / condition \u00b7 medians",
      "size": 15,
      "fill": "#f5f6f7",
      "weight": 500,
