  {
    "name": "t3_thread_update",
    "description": "Update metadata for a thread. Omit threadId to update this thread. Use action='rename' with title, action='regenerate_title' with no extra field, action='link_pull_request' with pullRequest, or action='unlink_pull_request'. Workspace and branch changes are intentionally not supported. clientRequestId makes retries idempotent.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "threadId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Thread to update. Omit to update the calling thread."
        },
        "action": {
          "type": "string",
          "enum": ["rename", "regenerate_title", "link_pull_request", "unlink_pull_request"],
          "description": "Metadata mutation: rename, regenerate_title, link_pull_request, or unlink_pull_request."
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "pullRequest": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "repository": {
                  "type": "string"
                },
                "number": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Pull request number."
                },
                "url": {
                  "type": "string"
                }
              },
              "required": ["repository", "number", "url"],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ],
          "description": "Pull request to link. Required only when action is link_pull_request."
        },
        "clientRequestId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["action"],
      "additionalProperties": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "threadId": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "enum": ["rename", "regenerate_title", "link_pull_request", "unlink_pull_request"],
          "description": "Metadata mutation: rename, regenerate_title, link_pull_request, or unlink_pull_request."
        },
        "commandId": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string"
        },
        "titleRegeneration": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "requestId": {
                  "type": "string"
                },
                "startedAt": {
                  "type": "string"
                }
              },
              "required": ["requestId", "startedAt"],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "linkedPullRequest": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "projectId": {
                  "type": "string"
                },
                "repository": {
                  "type": "string"
                },
                "number": {
                  "type": "integer",
                  "minimum": 1
                },
                "url": {
                  "type": "string"
                }
              },
              "required": ["projectId", "repository", "number", "url"],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "threadId",
        "action",
        "commandId",
        "sequence",
        "title",
        "titleRegeneration",
        "linkedPullRequest",
        "updatedAt"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "title": "Update T3 thread metadata",
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "t3_thread_send",
    "description": "Send a message to any T3 thread in this environment. The target cannot have broader permission modes than the caller. Do not use a delegated task's childThreadId to start another review round here; use delegate_task with the full review context and a new clientRequestId for that round. Thread messages do not create a new delegated task or reopen a completed task. mode='auto' starts an idle thread, steers a fully active turn, or queues behind a turn that is not yet steerable. Use queue for a separate follow-up turn, steer for an in-flight update, or restart to interrupt-and-restart the active turn. clientRequestId makes retries idempotent.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "threadId": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "mode": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["auto", "queue", "steer", "restart"]
            },
            {
              "type": "null"
            }
          ]
        },
        "clientRequestId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["threadId", "message"],
      "additionalProperties": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "threadId": {
          "type": "string"
        },
        "messageId": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "preparing",
            "queued",
            "starting",
            "running",
            "waiting",
            "completed",
            "interrupted",
            "failed",
            "cancelled",
            "rolled_back"
          ]
        },
        "delivery": {
          "type": "string",
          "enum": ["started", "queued", "steered", "restarted"]
        }
