                "type": "string"
              },
              "link": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "createdBy": {
                "type": "string",
                "enum": ["user", "agent", "system"]
              },
              "creationSource": {
                "type": "string",
                "enum": ["web", "mobile", "mcp", "provider", "server"]
              },
              "status": {
                "type": "string",
                "enum": [
                  "idle",
                  "preparing",
                  "queued",
                  "starting",
                  "running",
                  "waiting",
                  "completed",
                  "interrupted",
                  "failed",
                  "cancelled",
                  "rolled_back"
                ]
              },
              "latestRunId": {
                "anyOf": [
                  {
                    "type": "string"
